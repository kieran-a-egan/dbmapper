@page "/"
<h1>Host spike</h1>
<p>Bundled local UI. No external resources.</p>
<p>Picked folder: <code>@picked</code></p>
<button @onclick="Pick">Pick folder</button>

@code {
    private string picked = "(none)";

    private void Pick()
    {
        // Native OS dialog via Photino.NET; returns null/empty when cancelled.
        var result = HostWindow.Window?.ShowOpenFolder("Choose a folder", null, false);
        picked = result is { Length: > 0 } ? result[0] : "(cancelled)";
    }
}
